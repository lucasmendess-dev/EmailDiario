@model List<EmailDiario.Models.Destinatario>

@{
    ViewData["Title"] = "Destinatários";
}

<h1>Destinatários</h1>

@if (Model.Count == 0)
{
    <p>Nenhum destinatário cadastrado.</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Nome</th>
                <th>E-mail</th>
                <th>Status</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var destinatario in Model)
            {
                <tr>
                    <td>@destinatario.Nome</td>
                    <td>@destinatario.Email</td>
                    <td>@(destinatario.Ativo ? "Ativo" : "Inativo")</td>
                </tr>
            }
        </tbody>
    </table>
}